# OpenAI is used only by Cloud Functions. Do not put OPENAI_API_KEY in Expo public env.
# Set it with: firebase functions:secrets:set OPENAI_API_KEY
# Local emulator: put OPENAI_API_KEY=... in functions/.secret.local

EXPO_PUBLIC_FIREBASE_API_KEY=...
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=...
EXPO_PUBLIC_FIREBASE_PROJECT_ID=...
EXPO_PUBLIC_FIREBASE_STORAGE_BUCKET=...
EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=...
EXPO_PUBLIC_FIREBASE_APP_ID=...
EXPO_PUBLIC_FIREBASE_MEASUREMENT_ID=...

# Set to true only when running the Functions emulator
# EXPO_PUBLIC_USE_FUNCTIONS_EMULATOR=true
# Physical device talking to emulator on your PC (use your LAN IP):
# EXPO_PUBLIC_FUNCTIONS_EMULATOR_HOST=192.168.1.10
